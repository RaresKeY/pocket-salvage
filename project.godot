; Engine configuration file.
config_version=5

[application]
config/name="Pocket Salvage"
config/version="0.1.5"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/min_width=320
window/size/min_height=320

[input_devices]
joypads/ignore_joypad_on_unfocused_application=true

[physics]
common/physics_interpolation=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/canvas_textures/default_texture_repeat=0
anti_aliasing/quality/msaa_2d=0

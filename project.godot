; Engine configuration file.
config_version=5

[application]
config/name="Random Game"
config/version="0.0.0"
run/main_scene="res://labs/pixel_scaling/lab.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=900
window/size/min_width=640
window/size/min_height=480

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/canvas_textures/default_texture_repeat=0
anti_aliasing/quality/msaa_2d=0

#!/bin/sh
set -eu

project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
runner=${GODOT_PODMAN_RUNNER:-"$project_root/../godot-podman/bin/godot-podman"}

if [ ! -x "$runner" ]; then
    echo "Godot Podman runner unavailable; set GODOT_PODMAN_RUNNER to its executable path." >&2
    exit 1
fi

exec "$runner" run --project "$project_root" --purpose check --display none -- sh -eu -c '
    godot --headless --path /workspace --editor --import --quit
    godot --headless --path /workspace --quit-after 2
'

          "expression": "0.3 * envelope(p, 0.01, 1.2) * tone([660, 880, 1320][min(2, int(p * 3.2))], t, 'square')"
        },
        "wrong": {
          "seconds": 0.4,
          "expression": "0.3 * envelope(p, 0.01, 0.8) * tone(110 if p < 0.5 else 92, t, 'saw')"
        },
        "eject": {
          "seconds": 0.35,
          "expression": "0.3 * envelope(p, 0.01, 1.2) * tone(sweep(180, 720, p), t, 'triangle')"
        },
        "tick": {
          "seconds": 0.07,
          "expression": "0.3 * envelope(p, 0.005, 2.0) * tone(1500, t, 'square')"
        },
        "finish": {
          "seconds": 0.9,

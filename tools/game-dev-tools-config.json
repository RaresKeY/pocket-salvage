        "ui_click": {
          "seconds": 0.09,
          "expression": "0.3 * envelope(p, 0.03, 2.5) * (tone(740, t, 'sine') * 0.8 + n * 0.12)"
        },
        "magnet_on": {
          "seconds": 0.35,
          "expression": "0.35 * envelope(p, 0.05, 1.0) * (tone(sweep(90, 260, p), t, 'saw') * 0.7 + tone(sweep(180, 520, p), t) * 0.3)"
        },
        "magnet_off": {
